generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

model Transaction {
  id             Int      @id @default(autoincrement())
  trx_id         String   @unique
  type           String
  date           DateTime
  amount         Decimal  @db.Decimal(15, 2)
  payment_method String
  description    String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("transactions")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  brand     String?
  sku       String?
  unit      String
  minStock  Int      @default(0)
  priceBuy  Decimal  @db.Decimal(15, 2)
  priceSell Decimal  @db.Decimal(15, 2)
  stock     Int      @default(0)
  imageUrl  String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]

  @@map("users")
}

model Business {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  namaUsaha    String
  jenisUsaha   String
  noTelp       String?
  alamat       String?
  tahunMulai   DateTime
  tahunAkhir   DateTime
  saldoKas     Decimal  @default(0)
  saldoBank    Decimal  @default(0)
  tarifPajak   Decimal  @default(0)
  stokNegatif  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("businesses")
}
